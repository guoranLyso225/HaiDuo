DB_USER=haiduo
DB_PASSWORD=replace-with-local-password
DATABASE_URL=jdbc:postgresql://localhost:5432/haiduo
REDIS_HOST=localhost
COOKIE_SECURE=true
# Local HTTP Compose demo only: set COOKIE_SECURE=false.
APP_PROFILE=demo
DEMO_PASSWORD=replace-with-at-least-12-characters
RABBIT_PASSWORD=replace-with-another-local-password
RABBIT_USER=haiduo
RABBIT_HOST=localhost
MESSAGING_ENABLED=false
STORAGE_BACKEND=local
FILE_ROOT=.haiduo-files
# S3 mode requires S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY.
# S3_ENDPOINT is optional for an S3-compatible service.
# Optional Shopify real connection; leave empty to show unavailable.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
# Base64-encoded 32 random bytes; preserve across restarts to decrypt tokens.
TOKEN_ENCRYPTION_KEY=

AI_DEMO=false
SEARCH_URL=

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
VECTOR_DATABASE_URL=
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
GRAFANA_PASSWORD=
TRACING_ENABLED=false
